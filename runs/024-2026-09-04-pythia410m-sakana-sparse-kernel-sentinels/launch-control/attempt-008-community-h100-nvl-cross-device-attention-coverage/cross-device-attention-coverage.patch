+def covered_opportunity(
+    logical_products: dict[str, Any],
+    linear_operations: list[str],
+    *,
+    attention: dict[str, Any] | None = None,
+) -> dict[str, Any]:
+    """Do not combine H100 attention counts with incompatible A100 unions."""
+    if attention is None:
+        return _original_covered_opportunity(logical_products, linear_operations)
+    try:
+        result = _original_covered_opportunity(
+            logical_products,
+            linear_operations,
+            attention=attention,
+        )
+    except ValueError as error:
+        measured = logical_products["measured"]
+        operations = measured["per_operation"]
+        q_only = int(attention["q_only_causal_zero_products"])
+        v_only = int(attention["v_only_causal_zero_products"])
+        canonical_qk = int(operations["qk_scores"]["zero_product_count"])
+        canonical_pv = int(operations["probability_value"]["zero_product_count"])
+        q_excess = q_only - canonical_qk
+        v_excess = v_only - canonical_pv
+        if q_excess <= 0 and v_excess <= 0:
+            raise
+        return {
+            "covered_zero_product_count": None,
+            "canonical_model_product_count": int(measured["model_product_count"]),
+            "R_covered": None,
+            "canonical_R_model": float(measured["R_model"]),
+            "linear_zero_products": {
+                operation: int(operations[operation]["zero_product_count"])
+                for operation in linear_operations
+            },
+            "q_only_causal_zero_products": q_only,
+            "v_only_causal_zero_products": v_only,
+            "attention_is_lower_bound": True,
+            "attention_is_lower_bound_on_runtime_device": True,
+            "comparable_to_canonical_R_model": False,
+            "canonical_attention_union_zero_products": {
+                "qk_scores": canonical_qk,
+                "probability_value": canonical_pv,
+            },
+            "cross_device_component_excess": {
+                "q_only_minus_canonical_qk_union": q_excess,
+                "v_only_minus_canonical_pv_union": v_excess,
+            },
+            "incomparability_reason": "H100 eager component count exceeds pinned A100 eager canonical union",
+            "original_invariant_error": str(error),
+            "not_runtime_speedup": True,
+        }
+    result["comparable_to_canonical_R_model"] = True
+    return result
+
 
