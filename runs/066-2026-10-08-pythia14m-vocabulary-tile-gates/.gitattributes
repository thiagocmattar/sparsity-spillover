# Preserve the byte hashes of sealed evidence on Windows checkouts.
artifacts/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/remote-control/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/attempts/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
# CLI stdout captures include its final blank line; preserve the original bytes.
prelaunch/status-snapshots/** -text whitespace=-blank-at-eof,trailing-space,space-before-tab,cr-at-eol
prelaunch/remote-preflight-*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/lease-training-001.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/source-001.receipt.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
prelaunch/retrieval-training-001.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/*.csv -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/*.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
observations/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
transfer/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
figures/*.pdf -text
inputs/**/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
*.py text eol=lf
*.sh text eol=lf
config.yaml text eol=lf
