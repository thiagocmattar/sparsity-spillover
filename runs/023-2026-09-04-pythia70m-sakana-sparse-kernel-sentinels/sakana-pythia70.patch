+// Exact signed dense-to-ELL packer used by the Pythia inference adapter.
+// One warp owns one row and ballot-prefix compaction preserves column order.
+__global__ void dense_to_ell_exact_kernel(
+    const __nv_bfloat16* __restrict__ dense,
+    __nv_bfloat16*       __restrict__ values,
+    uint16_t*            __restrict__ columns,
+    int*                 __restrict__ row_counts,
+    int M_rows,
+    int K_cols
+) {
+    const int warp_id = threadIdx.x / WARP_SIZE_WPR;
+    const int lane = threadIdx.x % WARP_SIZE_WPR;
+    const int row = blockIdx.x * WARPS_PER_BLOCK_WPR + warp_id;
+    if (row >= M_rows) return;
+
+    const __nv_bfloat16* dense_row = dense + (size_t)row * K_cols;
+    __nv_bfloat16* value_row = values + (size_t)row * K_cols;
+    uint16_t* column_row = columns + (size_t)row * K_cols;
+    int packed = 0;
+    for (int base = 0; base < K_cols; base += WARP_SIZE_WPR) {
+        const int column = base + lane;
+        const __nv_bfloat16 value = column < K_cols ? dense_row[column] : __float2bfloat16(0.0f);
+        const bool nonzero = column < K_cols && __bfloat162float(value) != 0.0f;
+        const unsigned mask = __ballot_sync(0xffffffffu, nonzero);
+        const int offset = __popc(mask & ((1u << lane) - 1u));
+        if (nonzero) {
+            value_row[packed + offset] = value;
+            column_row[packed + offset] = static_cast<uint16_t>(column);
+        }
+        packed += __popc(mask);
     }
+    if (lane == 0) row_counts[row] = packed;
 }
 // Persistent grid: each block work-steals rows via atomicAdd on work_counter
 // to amortise wave-scheduling overhead at large N.
