+void dense_to_ell_exact_out(
+    at::Tensor dense,
+    at::Tensor values,
+    at::Tensor columns,
+    at::Tensor row_counts
+) {
+    TORCH_CHECK(dense.is_cuda(), "dense_to_ell_exact expects a CUDA tensor");
+    TORCH_CHECK(dense.scalar_type() == at::kBFloat16, "dense_to_ell_exact expects BF16 input");
+    TORCH_CHECK(dense.dim() == 2 && dense.is_contiguous(),
+                "dense_to_ell_exact expects a contiguous rank-2 tensor");
+    const int64_t M = dense.size(0);
+    const int64_t K = dense.size(1);
+    TORCH_CHECK(M > 0 && K > 0 && K <= 65535,
+                "dense_to_ell_exact requires positive dimensions and K <= 65535");
+    TORCH_CHECK(values.is_cuda() && columns.is_cuda() && row_counts.is_cuda(),
+                "dense_to_ell_exact workspaces must be CUDA tensors");
+    TORCH_CHECK(values.scalar_type() == at::kBFloat16 && columns.scalar_type() == at::kUInt16 &&
+                row_counts.scalar_type() == at::kInt,
+                "dense_to_ell_exact workspace dtypes must be BF16, uint16, int32");
+    TORCH_CHECK(values.is_contiguous() && columns.is_contiguous() && row_counts.is_contiguous(),
+                "dense_to_ell_exact workspaces must be contiguous");
+    TORCH_CHECK(values.sizes() == dense.sizes() && columns.sizes() == dense.sizes() &&
+                row_counts.dim() == 1 && row_counts.size(0) == M,
+                "dense_to_ell_exact workspace shapes do not match the input");
+    TORCH_CHECK(values.get_device() == dense.get_device() && columns.get_device() == dense.get_device() &&
+                row_counts.get_device() == dense.get_device(),
+                "dense_to_ell_exact tensors must share one CUDA device");
+    auto stream = at::cuda::getCurrentCUDAStream(dense.get_device());
+    const int grid = ((int)M + WARPS_PER_BLOCK_WPR - 1) / WARPS_PER_BLOCK_WPR;
+    dense_to_ell_exact_kernel<<<grid, WARPS_PER_BLOCK_WPR * WARP_SIZE_WPR, 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(dense.data_ptr()),
+        static_cast<__nv_bfloat16*>(values.data_ptr()),
+        static_cast<uint16_t*>(columns.data_ptr()),
+        static_cast<int*>(row_counts.data_ptr()),
+        (int)M,
+        (int)K
+    );
+    cudaError_t launch_error = cudaGetLastError();
+    TORCH_CHECK(launch_error == cudaSuccess, "dense_to_ell_exact launch failed: ", cudaGetErrorString(launch_error));
+}
+
+std::tuple<at::Tensor, at::Tensor, at::Tensor> dense_to_ell_exact(at::Tensor dense) {
+    auto values = at::empty(dense.sizes(), dense.options());
+    auto columns = at::empty(dense.sizes(), dense.options().dtype(at::kUInt16));
+    auto row_counts = at::empty({dense.size(0)}, dense.options().dtype(at::kInt));
+    dense_to_ell_exact_out(dense, values, columns, row_counts);
+    return {values, columns, row_counts};
+}
